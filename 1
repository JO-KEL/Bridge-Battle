-- ================= KONFIGURASI =================
local Config = {
    AutoPlace = false,
    AutoTake = false,
    AutoPath = false,
    AutoShoot = false,
    
    PlaceDelay = 0.15,       -- Jeda antar place
    TakeRadius = 50,         -- Jarak deteksi item buat diambil
    TargetItemName = "Stud", -- Nama item yang mau di-auto-take (bisa "Coin", "Cash", dll)
    WalkSpeed = 35,          -- Kecepatan lari saat auto path
}

-- ================= VARIABEL STATE =================
local placingLoop = false
local takingLoop = false
local pathLoop = false
