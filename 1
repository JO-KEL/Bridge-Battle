--[[
    BRIDGE BATTLES — FINAL SAFE BOT
    Fitur: Auto Place, Auto Take, Auto Path, Auto Shoot
    Status: Zero-Loop-Leak (Anti Force Close)
]]

-- Kill Switch (Hapus script lama kalau di-execute ulang)
if _G.BridgeBotLoaded then
    pcall(function() _G.BridgeBotLoaded:Destroy() end)
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ================= KONFIGURASI =================
local Config = {
    AutoPlace = false,
    AutoTake = false,
    AutoPath = false,
    AutoShoot = false,
    PlaceDelay = 0.25, -- Jeda aman
}

-- ================= HELPER =================
local function safeClick()
    -- Metode 1: Pakai Tool Activate (Paling aman dari crash)
    pcall(function()
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end
    end)
    
    -- Metode 2: Simulasi klik Mouse (Bypass VIM yang sering crash)
    pcall(function()
        local buttonDown = Instance.new("MouseButton1Down")
        -- Fallback klik pakai UserInputService
        UserInputService.InputBegan:Fire(Enum.UserInputType.MouseButton1) 
        -- (Catatan: Jika game pakai sistem Custom, klik ini mungkin tidak nyampe, 
        -- tapi setidaknya tidak bakal nge-crash game lo)
    end)
end

-- ================= CORE LOOP (SATU LOOP UNTUK SEMUA) =================
-- Ini mencegah kebocoran memori (force close)
RunService.Heartbeat:Connect(function()
    if Config.AutoPlace or Config.AutoShoot then
        safeClick()
        task.wait(Config.PlaceDelay) -- Throttle
    end

    if Config.AutoTake then
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if hrp and hum then
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("BasePart") and string.find(obj.Name, "Stud", 1, true) then
                        if (obj.Position - hrp.Position).Magnitude < 30 then
                            hum:MoveTo(obj.Position)
                            break
                        end
                    end
                end
            end
        end)
        task.wait(0.5)
    end

    if Config.AutoPath then
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if hrp and hum then
                -- Jalan maju lurus 50 stud
                local forward = hrp.CFrame.LookVector * 50
                hum:MoveTo(hrp.Position + forward)
            end
        end)
        task.wait(0.8)
    end
end)

