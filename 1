local vim = game:GetService("VirtualInputManager")

-- ================= HELPER: KLIK KIRI =================
local function leftClick()
    -- Metode 1: Executor bawaan
    if type(mouse1click) == "function" then
        mouse1click()
        return
    end
    -- Metode 2: Virtual Input Manager
    if vim then
        local mouse = LocalPlayer:GetMouse()
        vim:SendMouseButtonEvent(mouse.X, mouse.Y, 0, true, game, 0)
        task.wait(0.01)
        vim:SendMouseButtonEvent(mouse.X, mouse.Y, 0, false, game, 0)
        return
    end
    -- Metode 3: Fallback Tool
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end
end

-- ================= HELPER: DAPATKAN POSISI ITEM =================
local function getNearestItem()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local hrp = char.HumanoidRootPart
    local nearest = nil
    local shortestDist = Config.TakeRadius
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(obj.Name, Config.TargetItemName, 1, true) then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                nearest = obj
            end
        end
    end
    return nearest
end

-- ================= FITUR 1: AUTO PLACE =================
task.spawn(function()
    while true do
        task.wait(Config.PlaceDelay + math.random() * 0.05)
        if Config.AutoPlace then
            leftClick()
        end
    end
end)

-- ================= FITUR 2: AUTO TAKE =================
task.spawn(function()
    while true do
        task.wait(0.1)
        if Config.AutoTake then
            local item = getNearestItem()
            if item then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    -- Teleport ke item (CFrame, bukan walk)
                    char.HumanoidRootPart.CFrame = item.CFrame
                    task.wait(0.2)
                end
            end
        end
    end
end)

-- ================= FITUR 3: AUTO PATHFINDING =================
local function walkTo(targetPos)
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true
    })
    
    local success, errorMessage = pcall(function()
        path:ComputeAsync(char.HumanoidRootPart.Position, targetPos)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        for _, waypoint in ipairs(path:GetWaypoints()) do
            if not Config.AutoPath then break end -- Stop kalau di-toggle off
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end
            humanoid:MoveTo(waypoint.Position)
            humanoid.MoveToFinished:Wait(1) -- Timeout 1 detik
        end
    end
end

task.spawn(function()
    while true do
        task.wait(1)
        if Config.AutoPath then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                -- Logika Pathfinding: Jalan ke titik terjauh di Z axis (ujung jembatan)
                -- Bisa dimodifikasi sesuai map
                local currentPos = char.HumanoidRootPart.Position
                local targetPos = Vector3.new(currentPos.X, currentPos.Y, currentPos.Z + 50) -- Contoh: maju 50 stud
                walkTo(targetPos)
            end
        end
    end
end)

-- ================= FITUR 4: AUTO SHOOT =================
task.spawn(function()
