--[[
    BRIDGE BATTLES — ULTIMATE BOT (FIXED CRASH)
    Fitur: Auto Pathfinding, Auto Take, Auto Place, Auto Shoot
    Status: Safe Mode (No Teleport, No Force Close)
]]

-- Kill Switch: Matiin script lama kalau lo re-execute
if _G.BridgeBotLoaded then
    _G.BridgeBotLoaded:Destroy()
end

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local PathfindingService = game:GetService("PathfindingService")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ================= KONFIGURASI =================
local Config = {
    AutoPlace = false,
    AutoTake = false,
    AutoPath = false,
    AutoShoot = false,
    
    PlaceDelay = 0.25,       -- Gue naikin jadi 0.25 biar server ngga nge-kick
    TargetItemName = "Stud", 
}

-- ================= HELPER (SUPER SAFE) =================
local function safeLeftClick()
    -- Hanya pakai VIM (VirtualInputManager). Jangan pakai mouse1click() biar ga crash.
    pcall(function()
        local x, y = Mouse.X, Mouse.Y
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

-- ================= LOOP: AUTO PLACE =================
task.spawn(function()
    while Config.AutoPlace do
        pcall(function()
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                safeLeftClick()
            end
        end)
        task.wait(Config.PlaceDelay + (math.random() * 0.1)) -- Random delay biar natural
    end
end)

-- ================= LOOP: AUTO SHOOT =================
task.spawn(function()
    while Config.AutoShoot do
        pcall(function()
            safeLeftClick()
        end)
        task.wait(0.15)
    end
end)

-- ================= LOOP: AUTO TAKE (FIX TELEPORT) =================
task.spawn(function()
    while Config.AutoTake do
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            if hrp and hum then
                local nearestItem, shortestDist = nil, 30 -- Radius pencarian 30 stud
                
                -- Cari item di workspace (pakai GetChildren biar ga lag)
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("BasePart") and string.find(obj.Name, Config.TargetItemName, 1, true) then
                        local dist = (obj.Position - hrp.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestItem = obj
                        end
                    end
                end
                
                if nearestItem then
                    -- JALAN KE ITEM (Bukan teleport, biar ga di-kick anti-cheat)
                    hum:MoveTo(nearestItem.Position)
                end
            end
        end)
        task.wait(0.5)
    end
end)

-- ================= LOOP: AUTO PATH =================
task.spawn(function()
    while Config.AutoPath do
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hum and hrp then
                -- Jalan ke depan (Z axis) sejauh 100 stud
                local targetPos = hrp.Position + (hrp.CFrame.LookVector * 100)
                hum:MoveTo(targetPos)
            end
        end)
        task.wait(1)
    end
end)


