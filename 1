    BRIDGE BATTLES — SMART BOT (TEAM DETECTION)
    Fitur: Auto Take (Sesuai Tim), Auto Path, Auto Place, Auto Shoot
    Status: No-Crash, Mobile/Emulator Friendly
]]

if _G.BridgeBotLoaded then
    pcall(function() _G.BridgeBotLoaded:Destroy() end)
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local Config = {
    AutoPlay = false,   -- Ini ngegabungin Take, Path, dan Place
    AutoShoot = false,
    WalkSpeed = 20,     -- Kecepatan jalan (aman dari anti-cheat)
}

local function getTool()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Tool")
end

-- Cari blok di tanah sesuai warna tim lo
local function getNearestTeamBlock()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not LocalPlayer.Team then return nil end
    
    local nearest = nil
    local shortest = 100 -- Jarak maksimal nyari blok
    
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            -- Cek apakah warnanya sama dengan tim, ATAU namanya mengandung nama tim
            local isTeamBlock = (obj.Color == LocalPlayer.TeamColor.Color) or 
                                (string.find(string.lower(obj.Name), string.lower(LocalPlayer.Team.Name), 1, true))
            
            -- Cek apakah ini blok (namanya ada tulisan "block" atau "stud")
            local isBlock = string.find(string.lower(obj.Name), "block", 1, true) or 
                            string.find(string.lower(obj.Name), "stud", 1, true)
            
            if isTeamBlock and isBlock then
                local dist = (obj.Position - hrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

-- Simulasi klik (Cocok buat CloudEmulator)
local function doPlace()
    local tool = getTool()
    if tool then
        pcall(function() tool:Activate() end)
    end
end

-- Loop Utama
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not (char and hum and hrp) then return end
    hum.WalkSpeed = Config.WalkSpeed

    -- FITUR AUTO SHOOT
    if Config.AutoShoot then
        doPlace() -- Di game ini biasanya tool sword/pistol diaktifin pakai klik
        task.wait(0.2)
    end

    -- FITUR AUTO PLAY (Take -> Walk -> Place)
    if Config.AutoPlay then
        local equippedTool = getTool()
        
        if equippedTool then
            -- LOGIKA 1: KALAU UDAH MEGANG BLOK, JALAN LURUS KE DEPAN
            local forwardPos = hrp.Position + (hrp.CFrame.LookVector * 15)
            hum:MoveTo(forwardPos)
            
            -- Sambil jalan, klik terus buat naruh blok kalau udah mentok ujung
            doPlace() 
        else
            -- LOGIKA 2: KALAU TANGAN KOSONG, CARI BLOK TIM LO
            local block = getNearestTeamBlock()
            if block then
                hum:MoveTo(block.Position)
                -- Kalau udah deket banget, pasti otomatis ke-ambil sama game-nya
            else
                -- Kalau blok ngga keliatan, jalan muter dikit nyari
                hum:MoveTo(hrp.Position + Vector3.new(math.random(-10,10), 0, math.random(-10,10)))
            end
        end
        task.wait(0.3)
    end
end)

